# Copia este archivo como .env y ajusta los valores. Nunca subas el .env real.

# Base de datos (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=api_db
DB_USER=root
DB_PASSWORD=

# JWT: la clave debe tener al menos 32 caracteres.
# Genera una con: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=
JWT_ISSUER=api-slim-php
# Vigencia del token en segundos
JWT_TTL=3600

# Muestra detalles de los errores en las respuestas (solo en desarrollo)
APP_DEBUG=false
